                  },
                  "executionId": {
                    "type": "string",
                    "pattern": "^EXE-\\d{4,}$"
                  },
                  "employeeId": {
                    "type": "string",
                    "pattern": "^EMP-\\d{3}$"
                  },
                  "channel": {
                    "default": "claude_code",
                    "type": "string",
                    "enum": [
                      "claude_code",
                      "claude_chat"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "needs_input",
                      "failed"
                    ]
                  },
                  "startedAt": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "endedAt": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "summary": {
                    "default": "",
                    "type": "string",
                    "maxLength": 2000
                  },
                  "output": {
                    "default": "",
                    "type": "string",
                    "maxLength": 200000
                  },
                  "logs": {
                    "default": [],
                    "maxItems": 500,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "at": {
                          "default": null,
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        }
                      },
                      "required": [
                        "message"
                      ]
                    }
                  },
                  "errors": {
                    "default": [],
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "openQuestions": {
                    "default": [],
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "deliverables": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "design",
                            "brand_guidelines",
                            "requirements",
                            "technical_spec",
                            "source_code",
                            "test_report",
                            "documentation",
                            "client_deliverable"
                          ]
                        },
                        "location": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      "required": [
                        "title",
                        "type",
                        "location"
                      ]
                    }
                  },
                  "handoff": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "to": {
                            "type": "string",
                            "pattern": "^EMP-\\d{3}$"
                          },
                          "note": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "to",
                          "note"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "schema",
                  "executionId",
                  "employeeId",
                  "status"
                ]
              }
            },
            "required": [
              "type",
              "result"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "message.post"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "project",
                  "department",
                  "decision",
                  "meeting",
                  "direct"
                ]
              },
              "projectKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "departmentId": {
                "type": "string",
                "enum": [
                  "executive",
                  "design",
                  "engineering",
                  "qa"
                ]
              },
              "authorId": {
                "type": "string",
                "pattern": "^EMP-\\d{3}$"
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              }
            },
            "required": [
              "type",
              "kind",
              "authorId",
              "body"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "approval.request"
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "urgent": {
                "type": "boolean"
              },
              "action": {
                "type": "string",
                "enum": [
                  "production_deployment",
                  "production_database_change",
                  "public_release",
                  "client_proposal",
                  "external_communication",
                  "contractual_commitment",
                  "spending",
                  "subscription_purchase",
                  "billing_change",
                  "sensitive_data_access",
                  "data_deletion",
                  "irreversible_change"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "requestedBy": {
                "type": "string",
                "pattern": "^EMP-\\d{3}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "impact": {
                "default": "",
                "type": "string",
                "maxLength": 5000
              },
              "risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "projectKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "taskKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "supportingFiles": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "label",
                    "url"
                  ]
                }
              }
            },
            "required": [
              "type",
              "action",
              "title",
              "requestedBy",
              "reason"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "approval.decide"
              },
              "by": {
                "type": "string",
                "const": "EMP-001"
              },
              "approvalKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "taskKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "note": {
                "default": "",
                "type": "string",
                "maxLength": 5000
              }
            },
            "required": [
              "type",
              "by",
              "decision"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "knowledge.upsert"
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "category": {
                "type": "string",
                "enum": [
                  "policy",
                  "development",
                  "design",
                  "qa",
                  "template",
                  "sop",
                  "decision",
                  "prompt",
                  "learning"
                ]
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "tags": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "authorId": {
                "type": "string",
                "pattern": "^EMP-\\d{3}$"
              }
            },
            "required": [
              "type",
              "key",
              "title",
              "category",
              "body",
              "authorId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "deliverable.record"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "deliverableType": {
                "type": "string",
                "enum": [
                  "design",
                  "brand_guidelines",
                  "requirements",
                  "technical_spec",
                  "source_code",
                  "test_report",
                  "documentation",
                  "client_deliverable"
                ]
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 2000
              },
              "projectKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "taskKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9/_-]{1,80}$"
              },
              "ownerId": {
                "type": "string",
                "pattern": "^EMP-\\d{3}$"
              },
              "version": {
                "default": "1",
                "type": "string",
                "maxLength": 50
              }
            },
            "required": [
              "type",
              "title",
              "deliverableType",
              "location",
              "ownerId"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "reportId",
    "sentAt",
    "source",
    "actions"
  ]
}
