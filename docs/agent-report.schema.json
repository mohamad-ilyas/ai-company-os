                    "location": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "title",
                    "type",
                    "location"
                  ]
                }
              },
              "handoff": {
                "anyOf": [
