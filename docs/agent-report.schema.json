                    "type": "object",
                    "properties": {
                      "to": {
                        "type": "string",
                        "pattern": "^EMP-\\d{3}$"
                      },
                      "note": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "to",
                      "note"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "review": {
                "type": "object",
                "properties": {
                  "reviewerId": {
                    "type": "string",
                    "pattern": "^EMP-\\d{3}$"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "changes_requested"
                    ]
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 5000
                  }
                },
                "required": [
                  "reviewerId",
                  "decision"
                ]
              }
